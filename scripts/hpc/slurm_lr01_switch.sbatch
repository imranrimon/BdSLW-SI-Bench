#!/bin/bash -l
# =====================================================================
# P2 BlockGCN lr-0.01 switch: run one packed task list concurrently on one GPU.
#   TASKS  = scripts/hpc/lr01_switch/tasks_J<n>.txt (one shell command per line,
#            generated by tools/lr01_switch_tasks.py)
#   MAXPAR = concurrent BlockGCN runs on the GPU (default 6)
#   TAIL   = optional command run after every task has finished (evals)
# Training goes through tools/run_resumable_seed.py (resume-safe) except the tool-
# driven cells (paired SMG, SMG(k), enrollment); their half-finished runs are moved
# aside first so the tools' --skip-existing eval marker cannot skip them.
# Submit: sbatch --export=ALL,TASKS=...,TAIL="..." -J lr01_J1 scripts/hpc/slurm_lr01_switch.sbatch
# =====================================================================
#SBATCH -J lr01_switch
#SBATCH -c 12
#SBATCH -n 1
#SBATCH --mem=96G
#SBATCH --gpus 1
#SBATCH -p <PARTITION>              # <-- set to your GPU partition (`sinfo -s`)
#SBATCH -t 47:00:00
#SBATCH --requeue
# (optional) #SBATCH --exclude=<bad-nodes>
#SBATCH -o slurm_logs/%x_%j.out
#SBATCH -e slurm_logs/%x_%j.err

set -eo pipefail
cd "$SLURM_SUBMIT_DIR"
mkdir -p slurm_logs/lr01_switch
source ~/miniconda3/etc/profile.d/conda.sh
conda activate bdsl_graph
export PYTHONIOENCODING=utf-8
export PYTHONPATH="$SLURM_SUBMIT_DIR:${PYTHONPATH:-}"

ok=0; for i in $(seq 1 12); do touch work_dir/.rw_$$ 2>/dev/null && { rm -f work_dir/.rw_$$; ok=1; break; }; echo "scratch not ready ($i/12)"; sleep 10; done
[ "$ok" = 1 ] || { echo "scratch down on $(hostname) -> requeue"; scontrol requeue "$SLURM_JOB_ID"; exit 1; }
if ! python -c "import torch,sys; sys.exit(0 if (torch.cuda.is_available() and torch.zeros(1).cuda().add_(1).item()==1.0) else 1)" 2>/dev/null; then
  echo "GPU unusable on $(hostname) -> requeue"; scontrol requeue "$SLURM_JOB_ID"; exit 1
fi

MAXPAR=${MAXPAR:-6}
# move aside half-finished tool-driven runs (no final checkpoint) so --skip-existing cannot skip them
for d in work_dir/bdsl_block_gcn_si_lr01_pairsmg_* work_dir/bdsl_block_gcn_si_lr01_divk* work_dir/bdsl_block_gcn_si_lr01_pers_*; do
  [ -d "$d" ] || continue
  case "$d" in *_test|*seentest|*unseentest|*.partial_*) continue;; esac
  ls "$d"/*_model-99.pt "$d"/*_model-29.pt >/dev/null 2>&1 && continue
  ls "$d"/eval_results/*.pkl >/dev/null 2>&1 || continue
  mv "$d" "$d.partial_$(date +%Y%m%d_%H%M%S)"; echo "moved aside partial $d"
done

n=0
while IFS= read -r CMD; do
  [ -z "$CMD" ] && continue
  n=$((n+1)); LOG="slurm_logs/lr01_switch/$(basename "$TASKS" .txt)_task$(printf %03d $n).log"
  echo "[launch $n] $CMD"
  bash -c "$CMD" > "$LOG" 2>&1 &
  while [ "$(jobs -rp | wc -l)" -ge "$MAXPAR" ]; do sleep 30; done
done < "$TASKS"
fail=0; for p in $(jobs -rp); do wait "$p" || fail=$((fail+1)); done
wait || true
echo "all $n tasks finished (non-zero exits counted at the end: $fail)"
grep -l -E "Traceback|Error" slurm_logs/lr01_switch/$(basename "$TASKS" .txt)_task*.log 2>/dev/null | sed 's/^/  check: /' || true

if [ -n "${TAIL:-}" ]; then echo "[tail] $TAIL"; bash -c "$TAIL"; fi
echo "=== $(basename "$TASKS") done ==="
