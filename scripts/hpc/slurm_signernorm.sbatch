#!/bin/bash -l
# =====================================================================
# P2 signer-normalized pose recipe (docs/signernorm_2026-10/): run one packed task list on this job's GPUs.
#   TASKS  = scripts/hpc/signernorm/tasks_<label>.txt (one shell command per line,
#            generated by tools/signernorm_tasks.py)
#   MAXPAR = concurrent runs PER GPU (default and cap 3: more than 3 OOM'd an A30)
#   PRE    = optional command run first (one lane of GPU 0), e.g. evals that need no training
#   TAIL   = optional command run after every task has finished (evals)
# Commands are dealt round-robin to the allocated GPUs (CUDA_VISIBLE_DEVICES pinned per lane).
# Training goes through tools/run_resumable_seed.py: on requeue/re-fire every run resumes from its
# latest checkpoint (never from epoch 0) and finished runs are skipped.
# Submit: sbatch --export=ALL,TASKS=scripts/hpc/signernorm/tasks_S1_0.txt -J sn_S1_0 scripts/hpc/slurm_signernorm.sbatch
# =====================================================================
#SBATCH -J signernorm
#SBATCH -c 24
#SBATCH -n 1
#SBATCH --mem=180G
#SBATCH --gpus 2
#SBATCH -p <PARTITION>              # <-- set to your GPU partition (`sinfo -s`)
#SBATCH -t 8:00:00
#SBATCH --signal=B:USR1@900
#SBATCH --open-mode=append
#SBATCH --requeue
# (optional) #SBATCH --exclude=<bad-nodes>
#SBATCH -o slurm_logs/%x_%j.out
#SBATCH -e slurm_logs/%x_%j.err

set -eo pipefail
cd "$SLURM_SUBMIT_DIR"
mkdir -p slurm_logs/signernorm
source ~/miniconda3/etc/profile.d/conda.sh
conda activate bdsl_graph
export PYTHONIOENCODING=utf-8
export PYTHONPATH="$SLURM_SUBMIT_DIR:${PYTHONPATH:-}"

# 8-h chunks (2026-10-12): Slurm sends USR1 15 min before the limit; requeue so every run
# resumes from its last checkpoint (a plain TIMEOUT is final; --requeue only covers node failures).
trap 'echo "[chunk] $(date "+%F %T") time limit near -> requeue $SLURM_JOB_ID"; scontrol requeue "$SLURM_JOB_ID"; exit 0' USR1
ok=0; for i in $(seq 1 12); do touch work_dir/.rw_$$ 2>/dev/null && { rm -f work_dir/.rw_$$; ok=1; break; }; echo "scratch not ready ($i/12)"; sleep 10; done
[ "$ok" = 1 ] || { echo "scratch down on $(hostname) -> requeue"; scontrol requeue "$SLURM_JOB_ID"; exit 1; }
if ! python -c "import torch,sys; n=torch.cuda.device_count(); sys.exit(0 if n>0 and all(torch.zeros(1).cuda(i).add_(1).item()==1.0 for i in range(n)) else 1)" 2>/dev/null; then
  echo "GPU unusable on $(hostname) -> requeue"; scontrol requeue "$SLURM_JOB_ID"; exit 1
fi

MAXPAR=${MAXPAR:-3}; [ "$MAXPAR" -le 3 ] || MAXPAR=3
IFS=, read -ra GPUS <<< "${CUDA_VISIBLE_DEVICES:-0}"
NG=${#GPUS[@]}
TB=$(basename "$TASKS" .txt)
echo "host $(hostname)  GPUs ${GPUS[*]}  MAXPAR/GPU $MAXPAR  tasks $TASKS"

# one lane runner per GPU: runs its share of the list, at most MAXPAR at a time
lane () {  # $1 = gpu index in GPUS, $2 = file with this GPU's commands
  local gi=$1 f=$2 k=0
  while IFS= read -r CMD; do
    [ -z "$CMD" ] && continue
    k=$((k+1)); local LOG="slurm_logs/signernorm/${TB}_g${gi}_task$(printf %03d $k).log"
    echo "[gpu ${GPUS[$gi]} launch $k $(date '+%F %T')] $CMD"
    CUDA_VISIBLE_DEVICES=${GPUS[$gi]} bash -c "$CMD" >> "$LOG" 2>&1 &
    while [ "$(jobs -rp | wc -l)" -ge "$MAXPAR" ]; do sleep 30; done
  done < "$f"
  wait || true
}

TMP=$(mktemp -d)
n=0
if [ -n "${PRE:-}" ]; then echo "$PRE" > "$TMP/g0"; fi
while IFS= read -r CMD; do
  [ -z "$CMD" ] && continue
  echo "$CMD" >> "$TMP/g$((n % NG))"; n=$((n+1))
done < "$TASKS"
for gi in $(seq 0 $((NG-1))); do [ -f "$TMP/g$gi" ] && lane "$gi" "$TMP/g$gi" & done
wait || true
echo "all $n tasks finished $(date '+%F %T')"
grep -l -E "Traceback|Error" slurm_logs/signernorm/${TB}_g*_task*.log 2>/dev/null | sed 's/^/  check: /' || true
if [ -n "${TAIL:-}" ]; then echo "[tail] $TAIL"; CUDA_VISIBLE_DEVICES=${GPUS[0]} bash -c "$TAIL" || true; fi
echo "=== $TB done ==="
